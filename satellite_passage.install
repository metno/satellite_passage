<?php

/**
 * Update the standard acquisition help text to include the newer satellites.
 */
function satellite_passage_update_9001(): void {
  $config = \Drupal::configFactory()->getEditable('satellite_passage.configuration');
  $helptext = $config->get('helptext.value');
  if (!is_string($helptext)) {
    return;
  }

  $updated_helptext = str_replace(
    [
      'Sentinel-1A and Sentinel-1B',
      'Sentinel-2A and Sentinel-2B',
      'Filtering for specific satellites can be achieved using the layer switcher icon on the top right corner.',
    ],
    [
      'Sentinel-1A and Sentinel-1C',
      'Sentinel-2A, Sentinel-2B, and Sentinel-2C',
      'Use the satellite checkboxes to show or hide individual satellites.',
    ],
    $helptext,
  );

  if ($updated_helptext !== $helptext) {
    $config->set('helptext.value', $updated_helptext)->save();
  }
}

/**
 * Replace the original default help text with the current map instructions.
 */
function satellite_passage_update_9002(): void {
  $config = \Drupal::configFactory()->getEditable('satellite_passage.configuration');
  $helptext = $config->get('helptext.value');
  $legacy_helptext = '<p>The KML files available on this page are retrieved from the <a href="https://sentinel.esa.int/web/sentinel/missions/sentinel-2/acquisition-plans">ESA website</a> and filtered to provide detailed information about the planned Sentinel-2 acquisitions within the Norwegian area of interst. Each KML file usually covers a period of 10-15 days. To select the time period slide the <strong>Start</strong> and <strong>End</strong> buttons below the map.</p><p>To know more about the satellite acquisition (i.e. ID, Mode, Observation Time, ect...) click on the passage stripe. When passing with the mouse on the passage stripe:</p><ul><li>Passages of Sentinel-2A, Sentinel-2B, and Sentinel-2C are highlighted in <strong class="w3-text-red">red</strong>.</li><li>Passages of Sentinel-1A and Sentinel-1C are highlighted in <strong class="w3-text-blue">blue</strong> for EW mode (sea) and <strong class="w3-text-green">green</strong> for IW mode (land).</li></ul><p>Use the satellite checkboxes to show or hide individual satellites.</p>';
  if ($helptext !== $legacy_helptext) {
    return;
  }

  $config->set(
    'helptext.value',
    '<p>The KML files available on this page are retrieved from the <a href="https://sentinel.esa.int/web/sentinel/missions/sentinel-1/observation-scenario/acquisition-segments">Sentinel-1</a> and <a href="https://sentinel.esa.int/web/sentinel/missions/sentinel-2/acquisition-plans">Sentinel-2</a> ESA websites and filtered for the Norwegian area of interest. Available acquisition plans include Sentinel-1A and Sentinel-1C, and Sentinel-2A, Sentinel-2B, and Sentinel-2C. Each KML file usually covers 10-15 days. Use the Start and End sliders to filter acquisitions by observation time.</p><p>Click a passage to view its acquisition details. Sentinel-2 passages are highlighted in red. Sentinel-1 passages are highlighted in blue for EW mode (sea) and green for IW mode (land). Use the satellite checkboxes to show or hide individual satellites.</p>',
  )->save();
}
