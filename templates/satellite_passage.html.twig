<section class="satellite-passage" data-satellite-passage>
  <div class="satellite-passage__toolbar" aria-label="{% trans %}Map controls{% endtrans %}">
    <fieldset class="satellite-passage__layers">
      <legend>{% trans %}Satellites{% endtrans %}</legend>
      <label><input type="checkbox" data-satellite-layer="S1A" checked> {% trans %}Sentinel-1A{% endtrans %}</label>
      <label><input type="checkbox" data-satellite-layer="S1C" checked> {% trans %}Sentinel-1C{% endtrans %}</label>
      <label><input type="checkbox" data-satellite-layer="S2A" checked> {% trans %}Sentinel-2A{% endtrans %}</label>
      <label><input type="checkbox" data-satellite-layer="S2B" checked> {% trans %}Sentinel-2B{% endtrans %}</label>
      <label><input type="checkbox" data-satellite-layer="S2C" checked> {% trans %}Sentinel-2C{% endtrans %}</label>
    </fieldset>
  </div>

  <div id="map" class="satellite-passage__map" role="region" tabindex="0" aria-label="{% trans %}Satellite acquisition map{% endtrans %}"></div>
  <div class="satellite-passage__popup" data-acquisition-popup role="dialog" aria-modal="false" aria-labelledby="acquisition-popup-title" hidden>
    <div class="satellite-passage__popup-header">
      <h2 id="acquisition-popup-title"></h2>
      <button type="button" data-popup-close aria-label="{% trans %}Close acquisition details{% endtrans %}">&times;</button>
    </div>
    <div class="satellite-passage__popup-content" data-acquisition-details tabindex="0" role="region" aria-label="{% trans %}Acquisition details{% endtrans %}"></div>
  </div>
  <p class="satellite-passage__status" data-map-status role="status" aria-live="polite"></p>

  <div class="satellite-passage__timeline">
    <label for="timeStartKml">{% trans %}Acquisition start (UTC){% endtrans %}</label>
    <output id="boxStart" for="timeStartKml"></output>
    <input id="timeStartKml" type="range" min="0" max="100" step="any" value="0" disabled>

    <label for="timeEndKml">{% trans %}Acquisition end (UTC){% endtrans %}</label>
    <output id="boxEnd" for="timeEndKml"></output>
    <input id="timeEndKml" type="range" min="0" max="100" step="any" value="100" disabled>
  </div>

  <div class="satellite-passage__help">
    {{ helptext }}
  </div>
</section>
